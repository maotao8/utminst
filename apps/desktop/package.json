{
  "name": "utminst",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "vite:dev": "vite dev",
    "vite:build": "vite build",
    "clean": "rm -rf node_modules dist src-tauri/target",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "tauri": "tauri",
